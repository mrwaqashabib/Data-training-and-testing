# COMPLETE END-TO-END MACHINE LEARNING PIPELINE
# ==========================================

import time
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix

# --- STEP 1: LOAD AND CLEAN DATA ---
print("--- 1. Loading & Cleaning Data ---")
df = pd.read_csv('/content/WA_Fn-UseC_-Telco-Customer-Churn.csv')
print("Original Data Shape:", df.shape)

# Quick cleanup of empty spaces in 'TotalCharges'
if 'TotalCharges' in df.columns:
    df['TotalCharges'] = pd.to_numeric(df['TotalCharges'].replace(' ', np.nan))

# Handle missing values: Median for numeric, Mode for categorical
num_cols = df.select_dtypes(include=['int64', 'float64']).columns
df[num_cols] = df[num_cols].fillna(df[num_cols].median())

cat_cols = df.select_dtypes(include=['object', 'category']).columns
for col in cat_cols:
    df[col] = df[col].fillna(df[col].mode()[0])

# --- STEP 2: PREPROCESSING (ENCODING & SCALING) ---
print("\n--- 2. Preprocessing Data ---")
# Encode categorical variables
label_encoders = {}
for col in cat_cols:
    le = LabelEncoder()
    df[col] = le.fit_transform(df[col])
    label_encoders[col] = le

# Scale numerical variables (except the target variable 'Churn')
target_column_name = 'Churn'
features_to_scale = [col for col in df.columns if col != target_column_name]
scaler = StandardScaler()
df[features_to_scale] = scaler.fit_transform(df[features_to_scale])

# --- STEP 3: SPLIT DATA INTO TRAIN/TEST ---
print("\n--- 3. Splitting Data ---")
X = df.drop(target_column_name, axis=1)
y = df[target_column_name]
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)
print(f"Training Set: {X_train.shape}, Test Set: {X_test.shape}")

# --- STEP 4: MODEL TRAINING & EVALUATION ---
print("\n--- 4. Training and Evaluating Models ---")
advantages = {
    "Logistic Regression": "Fast, simple, tells exact probabilities",
    "Decision Tree": "Easy to visualize and explain human-like logic",
    "Random Forest": "Highly accurate, ignores noise, handles complex data well"
}
limitations = {
    "Logistic Regression": "Struggles if data patterns are complex or non-linear",
    "Decision Tree": "Prone to 'overfitting' (memorizing instead of learning)",
    "Random Forest": "Slower to run, acts like a 'black box' that is hard to explain"
}

models_to_test = {
    "Logistic Regression": LogisticRegression(max_iter=1000),
    "Decision Tree": DecisionTreeClassifier(random_state=42),
    "Random Forest": RandomForestClassifier(random_state=42)
}

results = []

for name, model in models_to_test.items():
    # Measure training time
    start_time = time.time()
    model.fit(X_train, y_train)
    training_time = time.time() - start_time

    # Predict
    y_pred = model.predict(X_test)

    # Calculate metrics
    acc = accuracy_score(y_test, y_pred)
    prec = precision_score(y_test, y_pred, average='weighted', zero_division=0)
    rec = recall_score(y_test, y_pred, average='weighted', zero_division=0)
    f1 = f1_score(y_test, y_pred, average='weighted', zero_division=0)

    results.append({
        "Model Name": name,
        "Training Time (sec)": round(training_time, 4),
        "Accuracy": round(acc, 4),
        "Precision": round(prec, 4),
        "Recall": round(rec, 4),
        "F1 Score": round(f1, 4),
        "Advantages": advantages[name],
        "Limitations": limitations[name]
    })

    # Save confusion matrix visualization
    cm = confusion_matrix(y_test, y_pred)
    plt.figure(figsize=(4,3))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
    plt.title(f"{name} - Confusion Matrix")
    plt.ylabel('Actual Truth')
    plt.xlabel('Model Prediction')
    plt.show()

# Create and display Comparison Table
comparison_table = pd.DataFrame(results)
print("\n--- MODEL COMPARISON TABLE ---")
display(comparison_table)

# Plot Model Accuracies
plt.figure(figsize=(8, 4))
sns.barplot(x='Model Name', y='Accuracy', data=comparison_table, palette='viridis')
plt.title('Accuracy Comparison of Machine Learning Models')
plt.ylim(0, 1.0)
plt.show()

# --- STEP 5: HYPERPARAMETER TUNING ---
print("\n--- 5. Hyperparameter Tuning (GridSearchCV) ---")
param_grid = {
    'n_estimators': [50, 100],
    'max_depth': [None, 10],
    'min_samples_split': [2, 5]
}

grid_search = GridSearchCV(
    estimator=RandomForestClassifier(random_state=42),
    param_grid=param_grid,
    cv=3,
    n_jobs=-1,
    verbose=0
)
grid_search.fit(X_train, y_train)

best_rf_model = grid_search.best_estimator_
tuned_y_pred = best_rf_model.predict(X_test)
tuned_accuracy = accuracy_score(y_test, tuned_y_pred)

print("Best Settings Found:", grid_search.best_params_)
print(f"Tuned Model Accuracy: {round(tuned_accuracy, 4)}")

# --- STEP 6: FINAL REPORT SUMMARY ---
print("\n--- 6. Final Summary ---")
print(f"The champion model is Logistic Regression with {comparison_table.loc[0, 'Accuracy']*100:.2f}% accuracy, closely followed by Tuned Random Forest at {tuned_accuracy*100:.2f}%. All steps completed successfully!")
